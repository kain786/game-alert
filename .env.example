# Set the origin served by your existing Caddy (no subpath).
PUBLIC_BASE_URL=https://games.example.com
WEB_PORT=18136
# Empty means ./data inside this distribution.
GEVENT_CACHE_DIR=
# Explicit opt-in after the DM test succeeds.
NOTIFICATIONS_ENABLED=false
REFRESH_INTERVAL_SECONDS=21600
NOTIFY_INTERVAL_SECONDS=600
SCHEDULE_CACHE_TTL_SECONDS=21600
